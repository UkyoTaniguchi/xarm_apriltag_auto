<launch>
  <!-- 引数の定義 -->
  <arg name="camera" default="cam_3" />
  <arg name="serial_no" default="243122070422" />
  <arg name="enable_pointcloud" default="true" />

  <!-- RealSense 起動（引数を渡す） -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="$(arg camera)" />
    <arg name="serial_no" value="$(arg serial_no)" />
    <arg name="enable_pointcloud" value="$(arg enable_pointcloud)" />
  </include>

  <include file="$(find apriltag_ros)/launch/continuous_detection.launch">
      <arg name="camera_name" value="/$(arg camera)/color" />
      <arg name="image_topic" value="image_raw" />
  </include>

  <!-- tag_0 に camera_link を固定で設置する静的TFブロードキャスト -->
  <node pkg="xarm_apriltag_demo"
        type="handeye_to_tag1_broadcast.py"
        name="cam3_static_camera_tf"
        output="screen" />
</launch>
